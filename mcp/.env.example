ALLOWED_HOSTS=homolab=192.168.31.178@homolab,server-jp=209.33.174.40@jp-root
SSH_CREDENTIALS=homolab,jp-root
SSH_USER=ops
SSH_PORT=22
SSH_KEY_PATH=C:\\Users\\you\\.ssh\\id_ed25519

# SSH_PASSWORD is only used when SSH_KEY_PATH is not set or fails.
# Prefer key-based authentication for security. Uncomment only if necessary.
# SSH_PASSWORD=replace-with-ssh-password

# Credential profiles are referenced from ALLOWED_HOSTS with @profile.
# Profile IDs are converted to CRED_<ID>_* by uppercasing and replacing
# non-alphanumeric characters with underscores.
# CRED_HOMOLAB_USER=mcpops
# CRED_HOMOLAB_SSH_PASSWORD=replace-with-homolab-password
# CRED_JP_ROOT_USER=root
# CRED_JP_ROOT_SSH_PASSWORD=replace-with-jp-password

# 1Panel compose projects are at /opt/1panel/apps/local (App Store) or a custom path.
# If you also have legacy projects under /data/compose, keep both entries in mind.
COMPOSE_ROOT=/opt/1panel/apps/local

# 1Panel API - Settings > System > API in the 1Panel dashboard.
# ONEPANEL_URL defaults to http://localhost:4444 (accessed via SSH on the managed host).
ONEPANEL_URL=http://localhost:4444
ONEPANEL_API_PREFIX=/api/v2
ONEPANEL_API_KEY=replace-with-1panel-api-key

# OpenClaw management defaults.
# Native installs use OPENCLAW_CLI_PATH. Docker Compose installs use
# OPENCLAW_COMPOSE_DIR plus the service names below.
OPENCLAW_CLI_PATH=openclaw
# OPENCLAW_COMPOSE_DIR=/opt/openclaw
OPENCLAW_CLI_SERVICE=openclaw-cli
OPENCLAW_GATEWAY_SERVICE=openclaw-gateway
OPENCLAW_GATEWAY_CONTAINER=openclaw-gateway
# Used as a fallback. openclaw_discover also reads the live Gateway probeUrl
# from `openclaw gateway status --json` when available.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Optional: Whitelist specific systemd services (comma-separated).
# If empty, all services are allowed.
# ALLOWED_SERVICES=nginx,docker,sshd

# Optional: Whitelist specific compose projects (comma-separated).
# If empty, all projects under COMPOSE_ROOT are allowed.
# ALLOWED_COMPOSE_PROJECTS=web,api,monitoring
